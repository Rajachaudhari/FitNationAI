# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitnation_ai
PGSSL=false

# Firebase Admin SDK
FIREBASE_PROJECT_ID=fitnation-ai-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@fitnation-ai-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=fitnation-ai-dev.appspot.com

# AI Provider ("openai" or "mock")
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=sk-...

# Observability
SENTRY_DSN=

# External Integrations
GOOGLE_MAPS_API_KEY=
